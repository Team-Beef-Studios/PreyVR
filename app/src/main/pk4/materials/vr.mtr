vr/weaponsight
{
	qer_editorimage	textures/zaphod/shotgun_laser.TGA
	translucent
	twoSided
	noShadows
	{
		blend add
		map models/images/laserdot.tga
	}
}

vr/weaponsightCircleDot
{
	qer_editorimage	textures/zaphod/shotgun_laser.TGA
	translucent
	twoSided
	noShadows
	{
		blend add
		map models/images/lasercircledot.tga
	}
}

vr/weaponsightCross
{
	qer_editorimage	textures/zaphod/shotgun_laser.TGA
	translucent
	twoSided
	noShadows
	{
		blend add
		map models/images/lasercrosshair.tga
	}
}

vr/weaponsight/laserbeam {
    qer_editorimage guis/assets/weaponsight/laserbeam.tga
    noShadows
    noSelfShadow
    twosided
    translucent
    nonsolid
    noimpact
    {
        blend add
        map guis/assets/weaponsight/laserbeam2.tga
        vertexcolor
        translate time * 0.10, 1.00
        noclamp
    }
    {
        blend add
        map guis/assets/weaponsight/laserbeam3.tga
        vertexcolor
        translate time * 0.10, time * 0.90
        noclamp
    }
}
